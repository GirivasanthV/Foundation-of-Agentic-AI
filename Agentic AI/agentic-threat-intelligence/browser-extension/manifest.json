{
  "manifest_version": 3,
  "name": "SentinelAI Browser Guard",
  "version": "0.4.0",
  "description": "Analyse visited public pages with threat intelligence and optional screenshot-based VLM review.",
  "permissions": ["tabs", "activeTab", "storage", "notifications"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SentinelAI Browser Guard",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
